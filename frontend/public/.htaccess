# ================================================================
# Shanker Agencies — Apache .htaccess
# For cPanel / BigRock Linux Shared Hosting (Apache 2.4+)
#
# DEPLOYMENT:
#   1. Build React app:  yarn build  (creates /build folder)
#   2. Upload ALL files in /build/ to public_html/
#   3. Upload THIS .htaccess to public_html/
#   4. Upload sitemap.xml and robots.txt to public_html/
#
# IMPORTANT: The filename must be  .htaccess  (with the dot)
# In Windows Explorer it shows as a file with no name — that is correct.
# In cPanel File Manager: upload → it appears as ".htaccess"
# ================================================================

Options -Indexes
Options -MultiViews

# ── 1. React SPA Routing ─────────────────────────────────────────
# All requests that don't match an existing file/folder go to index.html
# This allows React Router (client-side routing) to work on direct URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite actual files (js, css, images, fonts, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  # Don't rewrite actual directories
  RewriteCond %{REQUEST_FILENAME} !-d
  # Don't rewrite symlinks
  RewriteCond %{REQUEST_FILENAME} !-l
  # Don't rewrite backend API calls (if backend on same domain/subdomain)
  RewriteCond %{REQUEST_URI} !^/api/
  # Don't rewrite sitemap/robots
  RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
  RewriteCond %{REQUEST_URI} !^/robots\.txt$

  # Everything else → React's index.html
  RewriteRule ^ /index.html [QSA,L]
</IfModule>

# ── 2. HTTPS Redirect ────────────────────────────────────────────
# UNCOMMENT the block below AFTER your SSL certificate is active.
# (BigRock cPanel: SSL/TLS → Install AutoSSL first)
#
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} off
#   RewriteCond %{HTTP_HOST} !^localhost
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ── 3. www → non-www (choose ONE, comment the other) ─────────────
# Option A — prefer non-www (e.g. shankeragencies.com):
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# </IfModule>
#
# Option B — prefer www (e.g. www.shankeragencies.com):
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ── 4. Security Headers ──────────────────────────────────────────
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Stop MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Enable XSS protection (legacy browsers)
  Header always set X-XSS-Protection "1; mode=block"
  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Permissions policy
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
  # Remove server fingerprinting
  Header unset Server
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ── 5. GZIP Compression ──────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE application/font-woff
  AddOutputFilterByType DEFLATE application/font-woff2
</IfModule>

# ── 6. Browser Caching ───────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # React build JS/CSS files have content hashes — cache forever
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType application/x-javascript      "access plus 1 year"
  ExpiresByType text/css                       "access plus 1 year"

  # HTML — short cache (index.html must not be cached)
  ExpiresByType text/html                      "access plus 0 seconds"

  # Images
  ExpiresByType image/png                      "access plus 6 months"
  ExpiresByType image/jpg                      "access plus 6 months"
  ExpiresByType image/jpeg                     "access plus 6 months"
  ExpiresByType image/gif                      "access plus 6 months"
  ExpiresByType image/webp                     "access plus 6 months"
  ExpiresByType image/svg+xml                  "access plus 6 months"
  ExpiresByType image/ico                      "access plus 1 year"
  ExpiresByType image/x-icon                   "access plus 1 year"

  # Fonts
  ExpiresByType font/woff                      "access plus 1 year"
  ExpiresByType font/woff2                     "access plus 1 year"
  ExpiresByType application/font-woff          "access plus 1 year"
  ExpiresByType application/font-woff2         "access plus 1 year"
  ExpiresByType font/ttf                       "access plus 1 year"
  ExpiresByType font/otf                       "access plus 1 year"

  # JSON / Feeds
  ExpiresByType application/json               "access plus 1 hour"
  ExpiresByType application/xml                "access plus 1 hour"
  ExpiresByType text/xml                       "access plus 1 hour"
</IfModule>

# Immutable cache for hashed static assets
<FilesMatch "\.(js|css|woff|woff2|ttf|otf|png|jpg|jpeg|gif|webp|svg|ico)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

# Never cache index.html (so React app updates are seen immediately)
<FilesMatch "^index\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>

# Never cache robots/sitemap
<FilesMatch "^(robots\.txt|sitemap\.xml)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=86400"
  </IfModule>
</FilesMatch>

# ── 7. Custom Error Pages → React handles them ───────────────────
ErrorDocument 404 /index.html
ErrorDocument 403 /index.html
ErrorDocument 500 /index.html

# ── 8. Force correct MIME types ──────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/json .json
</IfModule>

# ── 9. Remove trailing slash (optional — avoids duplicate URLs) ──
# <IfModule mod_rewrite.c>
#   RewriteCond %{REQUEST_FILENAME} !-d
#   RewriteRule ^(.*)/$ /$1 [L,R=301]
# </IfModule>